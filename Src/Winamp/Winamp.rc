            MENUITEM "&Shuffle\tS",                 WINAMP_FILE_SHUFFLE
        END
        POPUP "Play&back"
        BEGIN
            MENUITEM "P&revious\tZ",                WINAMP_BUTTON1
            MENUITEM "&Play\tX",                    WINAMP_BUTTON2
